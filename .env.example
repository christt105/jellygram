# Environment variables for Cinegram - Example Template
JELLYFIN_URL=http://your-jellyfin-host:8096
JELLYFIN_TOKEN=your_jellyfin_token_here

# Telegram Bot configuration
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Single ID, or a comma-separated list to authorize several users
# (e.g. 123456789,987654321). The first ID is the owner: media is stored in
# that user's chat.
TELEGRAM_AUTH_USER_ID=your_telegram_user_id_here
# Optional override for the part size used when splitting large files.
# Defaults to 1950, or 3900 with a Premium user account session
# (see "Telegram user account" in the README).
#UPLOAD_SPLIT_LIMIT_MB=1950

# TMDB configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CONTENT_LANGUAGE=en-US   # Language for movie/series titles and overviews (e.g. es-ES, fr-FR)

# Host path for the media root, bind-mounted whole into bot-net at /data/media
# so moves between its subfolders stay on the same filesystem (atomic rename,
# no cross-device copy+delete).
MEDIA_ROOT=/path/to/media

# Subdirectories of MEDIA_ROOT, relative paths. DOWNLOADS_SUBDIR is where a
# future watcher will pick up finished downloads to import into the library.
MOVIES_SUBDIR=movies
SHOWS_SUBDIR=shows
DOWNLOADS_SUBDIR=downloads

# Only needed if Jellyfin reports paths that differ from the host ones above
# (e.g. it runs in its own container with different mounts). Comma-separated
# jellyfin_path:container_path pairs. See "Path mapping" in the README.
#JELLYFIN_PATH_MAP=/media/movies:/data/media/movies,/media/shows:/data/media/shows

# Docker service user and group permissions
PUID=1000
PGID=1000

# Host ports (change these if a port is already in use on your host)
WEB_PORT=5173
BACKEND_PORT=8005
BOT_NET_PORT=8088

# Image tag to deploy (pin to a release like v1.0.0, or leave as latest)
CINEGRAM_TAG=latest
